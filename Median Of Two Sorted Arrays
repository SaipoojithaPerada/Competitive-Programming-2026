import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int m = sc.nextInt();

        int[] a = new int[n];
        int[] b = new int[m];

        // Read first array
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        // Read second array
        for (int i = 0; i < m; i++) {
            b[i] = sc.nextInt();
        }

        int s = n + m;
        int[] res = new int[s];

        int i = 0, j = 0, k = 0;

        // Merge two sorted arrays
        while (i < n && j < m) {
            if (a[i] <= b[j]) {
                res[k++] = a[i++];
            } else {
                res[k++] = b[j++];
            }
        }

        // Copy remaining elements
        while (i < n) {
            res[k++] = a[i++];
        }

        while (j < m) {
            res[k++] = b[j++];
        }

        // Find median
        if (s % 2 == 1) {
            System.out.printf("%.1f", (double) res[s / 2]);
        } else {
            double avg = (res[s / 2] + res[s / 2 - 1]) / 2.0;
            System.out.printf("%.1f", avg);
        }
    }
}


