import java.io.*;
import java.util.*;

public class Solution {
    static int toggle(int n,int k){
        return n^(1<<k);
    }

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int k=sc.nextInt();
        int result=toggle(n,k);
        System.out.println(result);
        
    }
}
