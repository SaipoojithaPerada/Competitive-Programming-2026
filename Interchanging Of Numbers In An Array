import java.util.*;
public class Solution {
    public static void main(String[] args) {
       Scanner sc= new Scanner(System.in);
       int a=sc.nextInt();
       int arr[]=new int[a];
       for(int i=0;i<a;i++){
        arr[i]=sc.nextInt();
       }
        int min=0;
        int max=0;
        for(int i=1;i<a;i++){
            if(arr[i]<arr[min]){
                min=i;
            }
            if(arr[i]>arr[max]){
                max=i;
            } 
        }
        int temp=arr[min];
        arr[min]=arr[max];
        arr[max]=temp;
        for(int i=0;i<a;i++){
            System.out.print(arr[i]+" " );
        }
       }   
    }

