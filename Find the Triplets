import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        long[] a = new long[n];

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextLong();
        }

        long x = sc.nextLong();

        Arrays.sort(a);

        boolean found = false;

        for (int i = 0; i < n - 2; i++) {

            if (i > 0 && a[i] == a[i - 1])
                continue;

            for (int j = i + 1; j < n - 1; j++) {

                if (j > i + 1 && a[j] == a[j - 1])
                    continue;

                for (int k = j + 1; k < n; k++) {

                    if (k > j + 1 && a[k] == a[k - 1])
                        continue;

                    if (a[i] + a[j] + a[k] == x) {
                        System.out.println(a[i] + " " + a[j] + " " + a[k]);
                        found = true;
                    }
                }
            }
        }

        if (!found)
            System.out.println("No Triplet Found");
    }
}
